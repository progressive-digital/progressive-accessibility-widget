  "bugs": {
    "url": "https://github.com/progressive-digital/progressive-accessibility-widget/issues"
  },
  "homepage": "https://github.com/progressive-digital/progressive-accessibility-widget",
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "css-loader": "^6.7.3",
    "html-loader": "^4.2.0",
    "mini-css-extract-plugin": "^2.7.5",
    "postcss-loader": "^7.3.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^3.3.2",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "webpack": "5.104.1",
    "webpack-cli": "^5.1.4"
  }
