{
  "name": "sienna-accessibility",
  "version": "1.0.5",
  "description": "Sienna: Accessibility Website Widget",
  "main": "./src/entry.ts",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "dev": "npx webpack --mode=development --watch",
    "prod": "npx webpack --mode=production && node scripts/remove-empty-style-entry.mjs",
    "test": "npm run prod && node --test tests/*.test.mjs"
  },
